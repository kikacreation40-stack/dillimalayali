# Frontend: embedded at build time. Use an HTTPS URL in production.
VITE_SERVER_URL=http://localhost:3001
# Backend: comma-separated exact frontend origins, without trailing slashes.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
# Use a persistent private directory on your Node host for reports.
REPORT_DIR=reports
