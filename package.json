{
  "name": "delhi-malayali-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "server:dev": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "server": "node --env-file-if-exists=.env dist-server/server/index.js",
    "start": "npm run server",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
